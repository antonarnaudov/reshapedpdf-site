---
/* The animated invoice. Decorative and aria-hidden: it demonstrates the product
   to people who can see it and says nothing to people who cannot, which is why
   the sentence above it carries the actual claim. */
---
<div class="vignette" aria-hidden="true">
  <div class="doc-h">IRONWORKS SUPPLY CO. <span class="inv">INVOICE #2041</span></div>
  <div style="height:14px"></div>
  <div class="row"><span>Anvil, 35 kg — forged steel</span><span>820.00</span></div>
  <div class="row">
    <span class="fix">
      <span class="old">Delivery: 14 Vitosha Blvd</span>
      <span class="reshape-box"></span>
      <span class="patch">Delivery: 22 Graf Ignatiev St</span>
    </span>
    <span>0.00</span>
  </div>
  <div class="row last"><span class="total">Total due</span><span class="amount">EUR 1,457.00</span></div>
  <span class="tag">R · reshape — read, matched, retyped</span>
</div>

<style>
  .vignette{max-width:660px;margin:60px auto 0;background:#fff;border-radius:8px;box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 1px rgba(244,242,236,.08);padding:38px 44px;text-align:left;position:relative}
  .doc-h{font-family:var(--ui);font-weight:700;color:#17171b;font-size:19px;letter-spacing:.01em}
  .inv{float:right;color:var(--ember);font-size:14px}
  .row{display:flex;justify-content:space-between;color:#3c3a33;font-size:14.5px;padding:9px 0;border-bottom:1px solid #eceae4}
  .row.last{border:none}
  .total{font-weight:700;color:#17171b}
  .amount{color:var(--ember);font-weight:700}
  .fix{position:relative;display:inline-block}
  .fix .old{color:#3c3a33}
  .patch{position:absolute;inset:-2px -4px;background:#fff;border-radius:2px;display:flex;align-items:center;padding:0 4px;color:#3c3a33;font-size:14.5px;white-space:nowrap;animation:retype 6s infinite}
  .reshape-box{position:absolute;inset:-5px -8px;border:1.5px dashed var(--ember);border-radius:4px;opacity:0;animation:box 6s infinite}
  @keyframes box{4%,26%{opacity:1}0%,36%,100%{opacity:0}}
  @keyframes retype{0%,30%{opacity:0}40%,92%{opacity:1}100%{opacity:0}}
  .tag{position:absolute;right:18px;bottom:14px;font-family:var(--mono);font-size:10.5px;color:var(--faint);background:var(--lighttable);border:1px solid var(--hair);padding:3px 9px;border-radius:6px}

  /* Someone who has asked their system to stop moving things means it. The
     vignette is a loop that never stops, so it is the first thing to hold still. */
  @media (prefers-reduced-motion: reduce) {
    .patch{animation:none;opacity:1}
    .reshape-box{animation:none;opacity:0}
  }
  @media(max-width:560px){.vignette{padding:26px 22px}}
</style>

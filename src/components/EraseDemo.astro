---
/* The lift demo. The stamp sits on top of a rule and a line of text; when it
   lifts, what shows is simply what was always drawn underneath — which is the
   entire pitch: a PDF is instructions, not pixels, so nothing is invented. */
---
<div class="paper crop lift" aria-hidden="true">
  <div class="doc-h">DELIVERY NOTE<span class="no">Nº 88-1042</span></div>
  <p class="line">Received in good order: two crates, forged fittings, 64&nbsp;kg gross.</p>
  <div class="ruled">
    <p class="line">Countersigned at the works gate, goods checked against the manifest.</p>
    <div class="stampzone">
      <span class="stamp">COPY — DO NOT INVOICE</span>
      <svg class="lasso" viewBox="0 0 240 84" fill="none">
        <ellipse cx="120" cy="42" rx="112" ry="36" stroke="var(--ember)" stroke-width="1.6" stroke-dasharray="7 6" />
      </svg>
      <span class="chip">C · lift — 9 marks deleted · background untouched</span>
    </div>
    <p class="line">Carrier’s note: left gate B at 07:40, unremarkable weather, roads dry.</p>
  </div>
  <div class="sig"><span>for Ironworks Supply Co.</span><span class="rule"></span></div>
</div>

<style>
  .lift{padding:26px 30px 30px;font-size:13px;width:100%;max-width:440px}
  .doc-h{font-weight:750;color:var(--paper-ink);font-size:15px;display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--paper-ink);padding-bottom:10px;margin-bottom:14px}
  .no{color:var(--ember);font-size:11.5px;font-family:var(--mono);font-weight:500}
  .line{color:var(--paper-dim);font-size:12.5px;line-height:1.55;margin:8px 0}
  .ruled{position:relative}

  .stampzone{position:relative;height:74px;margin:2px 0;border-bottom:1px solid var(--paper-rule)}
  .stamp{position:absolute;left:50%;top:50%;translate:-50% -50%;rotate:-7deg;font-family:var(--mono);font-weight:700;font-size:14px;letter-spacing:.08em;color:var(--stamp);border:2.5px solid var(--stamp);border-radius:4px;padding:7px 14px;white-space:nowrap;opacity:.85;animation:stamp 8s infinite;mask-image:radial-gradient(circle at 30% 40%,#000 60%,rgba(0,0,0,.72) 78%,#000)}
  .lasso{position:absolute;inset:0;width:100%;height:100%;overflow:visible;opacity:0;animation:lasso 8s infinite}
  .lasso ellipse{stroke-dashoffset:0}
  .chip{position:absolute;left:50%;bottom:-8px;translate:-50%;font-family:var(--mono);font-size:10px;color:var(--paper);background:#26262b;border-radius:5px;padding:4px 9px;white-space:nowrap;opacity:0;animation:chip 8s infinite;box-shadow:0 4px 14px rgba(0,0,0,.25)}

  .sig{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-top:16px;color:var(--paper-faint);font-size:11px}
  .sig .rule{flex:1;border-bottom:1px solid var(--paper-dim);max-width:150px}

  /* 8-second reel: lasso draws → marks identified → stamp lifts clean off →
     the rule beneath was there all along → stamp returns for the next pass. */
  @keyframes lasso{6%,34%{opacity:1}0%,2%,40%,100%{opacity:0}}
  @keyframes stamp{
    0%,30%{opacity:.85;translate:-50% -50%;rotate:-7deg;scale:1;filter:blur(0)}
    38%,64%{opacity:0;translate:-50% -110%;rotate:-4deg;scale:1.05;filter:blur(1.5px)}
    74%,100%{opacity:.85;translate:-50% -50%;rotate:-7deg;scale:1;filter:blur(0)}
  }
  @keyframes chip{40%,60%{opacity:1}0%,36%,68%,100%{opacity:0}}

  @media (prefers-reduced-motion: reduce){
    .stamp{animation:none;opacity:0}
    .lasso{animation:none;opacity:0}
    .chip{animation:none;opacity:1}
  }
  @media(max-width:560px){.lift{padding:20px 18px}}
</style>

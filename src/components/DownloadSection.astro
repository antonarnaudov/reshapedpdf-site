---
import { LATEST, PLATFORMS } from '../data/site'
---
<section class="dl" id="download"><div class="wrap">
  <div class="sec-label reveal"><b>§ 05</b> get it</div>
  <h2 class="reveal">On your bench in a minute.</h2>
  <p class="lede reveal">Free forever for everything local, and open source. No account — the download is the whole onboarding.</p>

  {/* What you are most likely to want, guessed from your browser and offered
      first. Everything else stays visible below: a guess that hides the
      alternatives is worse than no guess. */}
  <div id="pick" class="pick reveal" hidden>
    <div class="pick-label" id="pick-label">Recommended for you</div>
    <a class="btn primary big" id="pick-btn" href={LATEST}>Download</a>
    <div class="pick-sub" id="pick-sub"></div>
  </div>

  <div class="grid reveal">
    {PLATFORMS.map((p) => (
      <div class="card">
        <h3>{p.name}</h3>
        <p set:html={`${p.formats}<br /><span class="dim">${p.requires}</span>`} />
        <a class="btn ghost" href={LATEST}>Downloads</a>
      </div>
    ))}
  </div>

  <p class="note center reveal" id="webapp-line">
    <span id="webapp" hidden>Or skip the install: the <a href="/app/" class="ember-link">web app</a> is the same editor, in your browser, files still on your machine.<br /></span>
    Every installer is built by CI from the public repository, with <code>SHA256SUMS.txt</code> beside
    it on the release page — the FAQ shows how to verify.
  </p>

  <div class="signing reveal">
    <div class="signing-h"><span class="reg"></span>The builds are not code-signed yet — your system will stop you once</div>
    <div class="signing-cols">
      <p><b>macOS 15+</b> — open it, let it be blocked, then System&nbsp;Settings → Privacy&nbsp;&amp;&nbsp;Security → <b>Open&nbsp;Anyway</b> (Apple removed the right-click trick). Or: <code>xattr -dr com.apple.quarantine /Applications/ReshapedPDF.app</code></p>
      <p><b>macOS 14 and earlier</b> — right-click the app → Open → Open.</p>
      <p><b>Windows</b> — SmartScreen → “More info” → “Run anyway”.</p>
      <p><b>Linux</b> — <code>chmod +x ReshapedPDF-*.AppImage</code></p>
    </div>
    <p class="signing-f">Signing certificates are on the list; a free tool today beat waiting for them.</p>
  </div>
</div></section>

{/* is:inline so Astro ships these byte for byte rather than bundling them —
    this page has no JavaScript build step and should not acquire one for two
    dozen lines. The strings come from the same data the cards above use, so the
    banner and the card can no longer disagree about what is published. */}
<script is:inline define:vars={{ LATEST, PLATFORMS }}>
  // Offer the right build first. The platform is a guess — navigator tells you
  // the OS and, on Apple Silicon, nothing reliable about the architecture — so
  // the guess names itself and the full list stays visible underneath it.
  ;(function () {
    var ua = navigator.userAgent, p = navigator.platform || ''
    var by = function (id) { return PLATFORMS.find(function (x) { return x.id === id }) }
    var picks = null
    if (/Mac/i.test(p) || /Mac OS X/i.test(ua)) picks = by('mac')
    else if (/Win/i.test(p) || /Windows/i.test(ua)) picks = by('win')
    // Android reports platform "Linux armv8l", so without the second test a
    // phone is offered a desktop AppImage it cannot run.
    else if ((/Linux/i.test(p) || /X11/i.test(ua)) && !/Android|Mobile/i.test(ua)) picks = by('linux')

    var box = document.getElementById('pick')
    if (!picks || !box) return
    document.getElementById('pick-label').textContent = picks.pickLabel
    var b = document.getElementById('pick-btn')
    b.textContent = picks.pickBtn; b.href = LATEST
    document.getElementById('pick-sub').textContent = picks.pickSub
    box.hidden = false
  })()

  // The browser editor is assembled into /app by scripts/sync-app.sh. If this
  // deployment does not have it, say nothing rather than offer a dead link.
  fetch('/app/index.html', { method: 'HEAD' })
    .then(function (r) { if (r.ok) document.getElementById('webapp').hidden = false })
    .catch(function () {})
</script>

<style>
  .dl{padding:104px 0;background:var(--bench);border-block:1px solid var(--hair)}
  .pick{text-align:center;margin:46px 0 10px}
  .pick-label{font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-bottom:12px}
  :global(.btn.big){font-size:16.5px;height:54px;padding:0 34px;border-radius:13px}
  .pick-sub{font-size:12.5px;color:var(--dim);margin-top:10px}

  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:36px}
  .card{background:var(--raised);border:1px solid var(--hair);border-radius:14px;padding:24px;text-align:center}
  .card h3{font-family:var(--disp);font-size:17px;color:var(--ink-bright);font-weight:640;margin-bottom:8px}
  .card p{font-size:13px;color:var(--dim);line-height:1.65}
  .card :global(.btn){margin-top:14px;height:38px;font-size:13.5px}
  :global(.dim){color:var(--faint);font-size:12px}

  .note{font-size:13px;color:var(--dim);line-height:1.75;margin-top:26px}
  .note.center{text-align:center;max-width:640px;margin-left:auto;margin-right:auto}
  .ember-link{color:var(--ember)}

  .signing{margin:38px auto 0;max-width:860px;border:1px dashed var(--hair-strong);border-radius:14px;padding:22px 26px;background:var(--inset)}
  .signing-h{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:12px;letter-spacing:.04em;color:var(--ink);margin-bottom:14px}
  .signing-h .reg{color:var(--ember)}
  .signing-cols{display:grid;grid-template-columns:1fr 1fr;gap:10px 28px}
  .signing-cols p{font-size:12.5px;color:var(--dim);line-height:1.7}
  .signing-cols b{color:var(--ink)}
  .signing-f{margin-top:14px;font-size:11.5px;color:var(--faint)}

  @media(max-width:840px){.grid{grid-template-columns:1fr}.signing-cols{grid-template-columns:1fr}}
</style>

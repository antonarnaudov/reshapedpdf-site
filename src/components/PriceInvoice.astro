---
import { INVOICE_LINES } from '../data/site'
/* The price list, typeset as what it is: an invoice with nothing on it. The
   stamp is the one joke on the page, so nothing else competes with it. */
---
<section id="price"><div class="wrap">
  <div class="sec-label reveal"><b>§ 04</b> the price</div>
  <h2 class="reveal">Here is the invoice.</h2>
  <p class="lede reveal">The features the suites bill monthly for, priced the way open source prices them.</p>

  <div class="paper crop statement reveal" role="table" aria-label="Price list: every feature costs 0.00, total due EUR 0.00, forever">
    <div class="doc-h">RESHAPEDPDF<span class="meta">STATEMENT · perpetual</span></div>
    <div class="cols" aria-hidden="true"><span>Item</span><span>Amount</span></div>
    {INVOICE_LINES.map((l) => (
      <div class="row"><span>{l.item}</span><span class="amt">{l.amount}</span></div>
    ))}
    <div class="row total"><span>Total due</span><span class="due">EUR 0.00 <em>— forever</em></span></div>
    <span class="stamp">FREE FOREVER</span>
  </div>

  <p class="note reveal">
    Not a trial, not a tier: everything that runs on your machine is free because the licence says
    so — MIT, in writing. The one thing that will ever cost money is ReshapedPDF&nbsp;Cloud, an
    optional hosted blending model for people who would rather not run their own. That subscription
    is what keeps the editor free.
  </p>
</div></section>

<style>
  section{padding:104px 0}
  .statement{max-width:620px;margin:52px auto 0;padding:34px 40px 38px;font-size:14px}
  .doc-h{font-family:var(--mono);font-weight:700;color:var(--paper-ink);font-size:15px;letter-spacing:.12em;display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--paper-ink);padding-bottom:12px}
  .meta{font-size:10.5px;color:var(--paper-faint);letter-spacing:.08em;font-weight:500}
  .cols{display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-faint);padding:12px 0 6px}
  .row{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid var(--paper-rule);color:var(--paper-dim)}
  .amt{font-family:var(--mono);font-size:12.5px;color:var(--paper-faint)}
  .row.total{border:none;padding-top:14px;font-weight:750;color:var(--paper-ink)}
  .due{color:var(--ember)}
  .due em{font-style:normal;font-weight:500;font-size:12px;color:var(--paper-faint)}

  .stamp{position:absolute;right:26px;bottom:70px;rotate:-11deg;font-family:var(--mono);font-weight:700;font-size:19px;letter-spacing:.14em;color:var(--ember);border:3px solid var(--ember);border-radius:6px;padding:8px 16px;opacity:.82;mask-image:radial-gradient(circle at 35% 55%,#000 55%,rgba(0,0,0,.7) 80%,#000);pointer-events:none}

  .note{max-width:560px;margin:30px auto 0;font-size:13px;color:var(--dim);text-align:center;line-height:1.75}
  @media(max-width:640px){.statement{padding:24px 20px 30px}.stamp{font-size:15px;right:14px;bottom:84px}}
</style>

---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Vignette from '../components/Vignette.astro'
import DownloadSection from '../components/DownloadSection.astro'
import { FEATURES, STEPS, PROVIDERS } from '../data/site'

const title = 'ReshapedPDF — every PDF is just material'
const description =
  'The free, private PDF editor. Fill, sign, annotate, redact and reshape — with AI edits that look like they were printed that way. Bring your own model or run one locally.'
---
<Base title={title} description={description} social>
  <Header />

  <section class="hero"><div class="wrap">
    <h1>Every PDF is just material.<br /><span class="heat">Reshape it.</span></h1>
    <p class="sub">
      The free, private PDF editor. Fill forms, sign, annotate, merge, truly redact — and retype
      printed text in its own typeface, so edits look like they were printed that way.
    </p>
    <div class="cta">
      <a class="btn primary" href="#download">Download free</a>
      <a class="btn ghost" href="#ai">See AI blending</a>
    </div>
    <div class="fine">macOS · Windows · Linux · or run it in any browser. No account. Nothing leaves your machine.</div>
    <Vignette />
  </div></section>

  <section id="features"><div class="wrap">
    <h2>Everything the expensive suites do</h2>
    <p class="lede">One tool for the PDF you didn't author but must fix by Friday.</p>
    <div class="grid">
      {FEATURES.map((f) => (
        <div class="card"><span class="em">{f.em}</span><h3>{f.title}</h3><p>{f.body}</p></div>
      ))}
    </div>
  </div></section>

  <section class="ai" id="ai"><div class="wrap">
    <h2>AI blending — <span class="heat">bring your own model</span></h2>
    <p class="lede">
      Like the magic erasers in phone photo editors, but for print: a vision model reads the text
      you drag over, matches its typeface, weight and color — and hands you the pen.
    </p>
    <div class="steps">
      {STEPS.map((s) => (
        <div class="step">
          <div class="n">{s.n}</div>
          <h3>{s.title}{s.kbd && <> <span class="kbd">{s.kbd}</span></>}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>

    <div class="clean-note">
      <h3>And the one you already know from your phone — <span class="heat">but honest</span></h3>
      <p>
        Press <span class="kbd">C</span> and draw around a logo, a stamp, a photo: it comes off the
        page. A phone has to <em>invent</em> the pixels underneath, because a photograph is all it
        has, and you can always tell — the smear where a pattern should continue, the ghost of the
        shape. A PDF is not a photograph. It is the instructions that drew the page, so ReshapedPDF
        asks the model only <em>which marks are the object</em> and then deletes those instructions.
        What appears underneath is not a guess at the background. It <b>is</b> the background, exactly
        as the document’s author drew it — down to the rule that ran under the logo. On a page that
        is genuinely just pixels — a photograph, a flat scan — there are no instructions to delete,
        so it rebuilds the texture the way a phone would, and tells you that is what it did.
      </p>
    </div>

    <div class="providers">
      {PROVIDERS.map((p) => <span class={`chip${p.kind ? ' ' + p.kind : ''}`}>{p.label}</span>)}
    </div>
    <p class="note">
      Local models keep every pixel on your machine. Recommended starter:
      <code>ollama pull qwen2.5vl:3b</code> (≈3 GB). Prefer zero setup? ReshapedPDF Cloud will offer our
      tuned blending models for a small subscription or a day pass — that's what keeps the editor free.
    </p>
  </div></section>

  <DownloadSection />
  <Footer />
</Base>

<style is:global>
  .hero{padding:96px 0 70px;text-align:center;position:relative;overflow:hidden}
  .hero::before{content:'';position:absolute;inset:-40% -20% auto;height:720px;background:radial-gradient(closest-side,rgba(255,92,31,.13),transparent 65%);pointer-events:none}
  h1{font-family:var(--disp);font-size:clamp(40px,6.4vw,68px);line-height:1.04;letter-spacing:-.03em;color:var(--ink-bright);font-weight:700}
  .hero p.sub{max-width:640px;margin:22px auto 0;font-size:18px;color:var(--dim)}
  .cta{display:flex;gap:12px;justify-content:center;margin-top:34px;flex-wrap:wrap}
  .hero .fine{margin-top:14px;font-size:12.5px;color:var(--faint)}

  section{padding:80px 0}
  h2{font-family:var(--disp);font-size:clamp(26px,3.6vw,38px);color:var(--ink-bright);letter-spacing:-.02em;font-weight:640;text-align:center}
  .lede{text-align:center;color:var(--dim);max-width:620px;margin:14px auto 0}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
  .card{background:var(--bench);border:1px solid var(--hair);border-radius:14px;padding:22px}
  .card h3{font-family:var(--disp);font-size:16.5px;color:var(--ink-bright);font-weight:640;margin-bottom:8px}
  .card p{font-size:13.5px;color:var(--dim)}
  .card .em{color:var(--ember);font-family:var(--mono);font-size:11px;letter-spacing:.08em;display:block;margin-bottom:10px}

  .ai{background:var(--bench);border-block:1px solid var(--hair)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
  .step{border:1px dashed var(--hair-strong);border-radius:14px;padding:22px;text-align:center}
  .step .n{font-family:var(--mono);color:var(--ember);font-size:12px;letter-spacing:.1em}
  .step h3{font-family:var(--disp);color:var(--ink-bright);font-size:17px;margin:8px 0 6px;font-weight:640}
  .step p{font-size:13.5px;color:var(--dim)}
  .clean-note{margin-top:38px;padding:26px 28px;border:1px solid var(--hair-strong);border-radius:14px;background:linear-gradient(180deg,rgba(255,92,31,.05),transparent)}
  .clean-note h3{font-family:var(--disp);font-size:20px;color:var(--ink-bright);font-weight:640;letter-spacing:-.01em}
  .clean-note p{margin-top:10px;color:var(--dim);font-size:15.5px;max-width:74ch}
  .clean-note b{color:var(--ink-bright)}
  .providers{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:34px}
  .chip{font-family:var(--mono);font-size:12px;padding:7px 14px;border-radius:999px;border:1px solid var(--hair-strong);color:var(--ink)}
  .chip.local{border-color:rgba(88,181,134,.5);color:var(--ok)}
  .chip.soon{opacity:.55}

  .note{max-width:640px;margin:30px auto 0;font-size:12.5px;color:var(--faint);text-align:center;line-height:1.7}
  .note code{font-family:var(--mono);color:var(--dim)}
  code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px}

  @media(max-width:840px){.grid,.steps{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.grid,.steps{grid-template-columns:1fr}}
</style>

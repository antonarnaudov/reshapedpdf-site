---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import RetypeDemo from '../components/RetypeDemo.astro'
import EraseDemo from '../components/EraseDemo.astro'
import RedactDemo from '../components/RedactDemo.astro'
import PriceInvoice from '../components/PriceInvoice.astro'
import DownloadSection from '../components/DownloadSection.astro'
import Faq from '../components/Faq.astro'
import { FEATURES, STEPS, PROVIDERS, PROOFS } from '../data/site'

const title = 'ReshapedPDF — every PDF is just material'
const description =
  'The free, private PDF editor. Fill, sign, annotate, redact and reshape — with AI edits that look like they were printed that way. Bring your own model or run one locally.'
---
<Base title={title} description={description} social>
  <Header />

  {/* ————— the pitch, then immediately the product ————— */}
  <section class="hero"><div class="wrap">
    <div class="eyebrow up-1"><span class="reg" aria-hidden="true"></span>free · private · open source — a PDF editor with a print shop’s hands</div>
    <h1 class="up-2">Every PDF is just<br class="h1-br" /> material. <span class="heat">Reshape&nbsp;it.</span></h1>
    <p class="sub up-3">
      Fill forms, sign, merge, truly redact — and retype printed text in its own typeface, so the
      edit looks like it was always there. On your machine, never on a server.
    </p>
    <div class="cta up-4">
      <a class="btn primary big" href="#download">Download free</a>
      <a class="btn ghost big" href="#features">Watch it work</a>
    </div>
    <div class="fine up-5">macOS · Windows · Linux · any browser — no account, no upload, no telemetry.</div>

    <figure class="bench-shot up-6">
      <span class="shot-reg tl" aria-hidden="true"></span><span class="shot-reg tr" aria-hidden="true"></span>
      <span class="shot-reg bl" aria-hidden="true"></span><span class="shot-reg br" aria-hidden="true"></span>
      <img src="/assets/editor-bench.png" width="1600" height="1000" fetchpriority="high"
        alt="The ReshapedPDF editor: a dark workbench with an invoice open on the light table, page thumbnails on the left, tool rail, and the AI assist panel on the right announcing that everything except AI clean runs without a model. A toast reports seven detected form fields." />
      <figcaption>The actual editor, actual sample — not a mock-up. Same code on desktop and in the browser.</figcaption>
    </figure>
  </div></section>

  {/* ————— the five facts that qualify everything else ————— */}
  <aside class="proof" aria-label="What you give up to use it: nothing">
    <div class="wrap"><ul>
      {PROOFS.map((p) => <li><span class="reg" aria-hidden="true"></span>{p}</li>)}
    </ul></div>
  </aside>

  {/* ————— the three headline acts, each shown rather than told ————— */}
  <section id="features"><div class="wrap">
    <div class="sec-label reveal"><b>§ 01</b> the headline acts</div>
    <h2 class="reveal">Three things you didn’t know<br />a PDF would put up with.</h2>

    <div class="act reveal">
      <div class="act-copy">
        <div class="act-k"><span class="kbd">R</span> retype in place</div>
        <h3>Change the words.<br />Keep the look.</h3>
        <p>
          Select any printed line and retype it. The patch is rebuilt from the document’s own
          letterforms — or a matched font, embedded on export — so a fixed typo, a corrected name,
          a new date reads like it came off the original press.
        </p>
        <p class="act-fine">Digital text needs no AI model. Latin exports as real, selectable type; Cyrillic, Greek &amp; CJK ride a crisp 3× raster.</p>
      </div>
      <div class="act-demo"><RetypeDemo /></div>
    </div>

    <div class="act flip reveal">
      <div class="act-copy">
        <div class="act-k"><span class="kbd">C</span> the honest eraser</div>
        <h3>Rub anything out.<br />Nothing is invented.</h3>
        <p>
          Draw around a stamp, a watermark, handwriting — it comes off the page. A phone’s eraser
          has to hallucinate the missing pixels; a PDF is the instructions that drew the page, so
          ReshapedPDF deletes the marks themselves. What appears underneath is the background the
          author drew, down to the rule that ran beneath the stamp.
        </p>
        <p class="act-fine">On a flat scan there are no instructions to delete — so it rebuilds the texture the way a phone would, and tells you that is what it did.</p>
      </div>
      <div class="act-demo"><EraseDemo /></div>
    </div>

    <div class="act reveal">
      <div class="act-copy">
        <div class="act-k">true redaction</div>
        <h3>Gone.<br />Not hidden.</h3>
        <p>
          Most tools sell you a black rectangle and call it redaction — then a journalist
          copy-pastes right underneath it. Tick <b>true redaction</b> on export and the covered
          content is removed from the page’s own drawing program. The copy-paste test comes back
          empty, because there is nothing left to find.
        </p>
        <p class="act-fine">Unticked, the box is only a box — the choice is explicit, never a surprise.</p>
      </div>
      <div class="act-demo"><RedactDemo /></div>
    </div>
  </div></section>

  {/* ————— the rest of the bench ————— */}
  <section class="bench-grid"><div class="wrap">
    <div class="sec-label reveal"><b>§ 02</b> the rest of the bench</div>
    <h2 class="reveal">And everything a Friday deadline needs.</h2>
    <p class="lede reveal">One tool for the PDF you didn’t author but must fix by tonight.</p>
    <div class="grid reveal">
      {FEATURES.map((f) => (
        <div class="card"><span class="em">{f.em}</span><h3>{f.title}</h3><p>{f.body}</p></div>
      ))}
    </div>
  </div></section>

  {/* ————— AI, strictly on your terms ————— */}
  <section class="ai" id="ai"><div class="wrap">
    <div class="sec-label reveal"><b>§ 03</b> the optional intelligence</div>
    <h2 class="reveal">AI blending — <span class="heat">bring your own model</span></h2>
    <p class="lede reveal">
      A vision model reads the print you drag over, matches its typeface, weight and color — and
      hands you the pen. Scans included. Local models keep every pixel on your machine.
    </p>
    <div class="steps reveal">
      {STEPS.map((s) => (
        <div class="step">
          <div class="n">{s.n}</div>
          <h3>{s.title}{s.kbd && <> <span class="kbd">{s.kbd}</span></>}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
    <div class="providers reveal">
      {PROVIDERS.map((p) => <span class={`chip${p.kind ? ' ' + p.kind : ''}`}>{p.label}</span>)}
    </div>
    <p class="note reveal">
      Recommended starter: <code>ollama pull qwen2.5vl:3b</code> (≈3&nbsp;GB) — free, offline, private.
      Prefer zero setup? ReshapedPDF Cloud will offer our tuned blending models for a small
      subscription or a day pass — that’s what keeps the editor free.
    </p>
  </div></section>

  <PriceInvoice />
  <DownloadSection />
  <Faq />
  <Footer />
</Base>

{/* The only scroll JavaScript on the page: stamp a class so CSS may hide
    things, watch them into view, get out of the way. Without JS (or with
    reduced motion) nothing is ever hidden — see global.css. */}
<script is:inline>
  ;(function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return
    var arm = function () {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('seen'); io.unobserve(e.target) }
        })
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el) })
    }
    // Hide-then-reveal only once the observer is armed; DOMContentLoaded may
    // already be behind us by the time an end-of-body script runs.
    document.documentElement.classList.add('js-reveal')
    if (document.readyState === 'loading') addEventListener('DOMContentLoaded', arm)
    else arm()
  })()
</script>

<style is:global>
  /* ————— hero ————— */
  .hero{padding:88px 0 84px;position:relative;overflow:clip}
  .hero::before{content:'';position:absolute;inset:-30% -10% auto;height:760px;background:radial-gradient(closest-side,rgba(255,92,31,.14),transparent 62%);pointer-events:none}
  .eyebrow{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
  .eyebrow .reg{color:var(--ember)}
  h1{font-family:var(--disp);font-size:clamp(46px,7.2vw,88px);line-height:1.01;letter-spacing:-.035em;color:var(--ink-bright);font-weight:720;margin-top:26px}
  .hero .sub{max-width:600px;margin-top:26px;font-size:18.5px;color:var(--dim);line-height:1.65}
  .cta{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
  .hero .fine{margin-top:16px;font-family:var(--mono);font-size:11.5px;letter-spacing:.03em;color:var(--faint)}

  .bench-shot{position:relative;margin:76px 0 0}
  .bench-shot img{display:block;width:100%;height:auto;border-radius:12px;border:1px solid var(--hair-strong);box-shadow:0 40px 120px rgba(0,0,0,.6),0 0 90px rgba(255,92,31,.07),0 6px 24px rgba(0,0,0,.5)}
  .bench-shot figcaption{margin-top:16px;text-align:center;font-family:var(--mono);font-size:11.5px;letter-spacing:.04em;color:var(--faint)}
  .shot-reg{position:absolute;width:15px;height:15px;color:var(--faint);pointer-events:none}
  .shot-reg::before,.shot-reg::after{content:'';position:absolute;background:currentColor}
  .shot-reg::before{left:7px;top:0;width:1px;height:15px}
  .shot-reg::after{top:7px;left:0;height:1px;width:15px}
  .shot-reg.tl{left:-26px;top:-26px}.shot-reg.tr{right:-26px;top:-26px}
  .shot-reg.bl{left:-26px;bottom:26px}.shot-reg.br{right:-26px;bottom:26px}

  /* load-in: one staggered rise, then the page is calm */
  @media (prefers-reduced-motion: no-preference){
    .up-1,.up-2,.up-3,.up-4,.up-5,.up-6{animation:rise .8s cubic-bezier(.2,.6,.2,1) backwards}
    .up-2{animation-delay:.06s}.up-3{animation-delay:.14s}.up-4{animation-delay:.22s}.up-5{animation-delay:.28s}.up-6{animation-delay:.38s}
    @keyframes rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  }

  /* ————— proof strip ————— */
  .proof{border-block:1px solid var(--hair);background:var(--bench)}
  .proof ul{display:flex;flex-wrap:wrap;gap:10px 34px;justify-content:center;list-style:none;padding:18px 0}
  .proof li{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;color:var(--ink)}
  .proof .reg{color:var(--ember);transform:scale(.8)}

  /* ————— acts ————— */
  section{padding:104px 0}
  .act{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;margin-top:96px}
  .act:first-of-type{margin-top:64px}
  .act.flip .act-copy{order:2}
  .act-k{display:flex;align-items:center;gap:9px;font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ember)}
  .act h3{font-family:var(--disp);font-size:clamp(26px,3vw,34px);line-height:1.12;letter-spacing:-.02em;color:var(--ink-bright);font-weight:660;margin-top:14px}
  .act p{margin-top:16px;font-size:15px;color:var(--dim);line-height:1.75;max-width:52ch}
  .act p b{color:var(--ink)}
  .act .act-fine{margin-top:14px;font-family:var(--mono);font-size:11px;line-height:1.7;color:var(--faint);border-left:2px solid var(--hair-strong);padding-left:12px}
  .act-demo{display:flex;justify-content:center}

  /* ————— bench grid ————— */
  .bench-grid .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}
  .bench-grid .card{background:var(--bench);border:1px solid var(--hair);border-radius:14px;padding:24px;transition:border-color .2s,transform .2s}
  .bench-grid .card:hover{border-color:rgba(255,92,31,.35);transform:translateY(-2px)}
  .bench-grid .card h3{font-family:var(--disp);font-size:16.5px;color:var(--ink-bright);font-weight:640;margin-bottom:8px}
  .bench-grid .card p{font-size:13.5px;color:var(--dim);line-height:1.7}
  .bench-grid .card .em{color:var(--ember);font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;display:block;margin-bottom:12px}

  /* ————— ai ————— */
  .ai{background:var(--bench);border-block:1px solid var(--hair)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}
  .step{border:1px dashed var(--hair-strong);border-radius:14px;padding:24px}
  .step .n{font-family:var(--mono);color:var(--ember);font-size:12px;letter-spacing:.1em}
  .step h3{font-family:var(--disp);color:var(--ink-bright);font-size:17px;margin:10px 0 6px;font-weight:640}
  .step p{font-size:13.5px;color:var(--dim);line-height:1.7}
  .providers{display:flex;gap:10px;flex-wrap:wrap;margin-top:36px}
  .chip{font-family:var(--mono);font-size:12px;padding:7px 14px;border-radius:999px;border:1px solid var(--hair-strong);color:var(--ink)}
  .chip.local{border-color:rgba(88,181,134,.5);color:var(--ok)}
  .chip.soon{opacity:.55}
  .ai .note{max-width:640px;margin-top:28px;font-size:12.5px;color:var(--faint);line-height:1.75}
  .ai .note code{color:var(--ink)}

  @media(max-width:1020px){
    .act{grid-template-columns:1fr;gap:40px;margin-top:72px}
    .act.flip .act-copy{order:0}
    .act-demo{justify-content:flex-start}
  }
  @media(max-width:840px){.bench-grid .grid,.steps{grid-template-columns:1fr 1fr}}
  @media(max-width:640px){
    .hero{padding-top:56px}
    .h1-br{display:none}
    .bench-grid .grid,.steps{grid-template-columns:1fr}
    .shot-reg{display:none}
    section{padding:84px 0}
  }
</style>
